{
  "rewrites": [
    { "source": "/kiosk/:path*", "destination": "/index.html" },
    { "source": "/kiosk", "destination": "/index.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/refresh-feed",
      "schedule": "0 11 * * *"
    }
  ]
}
