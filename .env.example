# Firebase Configuration
# Get these from: https://console.firebase.google.com/
# Project Settings > General > Your apps > Web app

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Anthropic API (for chat AI backend)
# Get this from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key

# Groq API (for concierge kiosk)
# Get this from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key

# Google Calendar (for concierge kiosk)
# Create a service account in GCP, share calendar with its email
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=info@distillerylabs.org

# Domain-wide delegation: impersonate this user to see their full calendar list
# Requires: GCP admin must grant the service account domain-wide delegation
GOOGLE_IMPERSONATE_EMAIL=info@distillerylabs.org

# Kiosk calendar IDs (comma-separated) — fallback if impersonation not available
# Find IDs in Google Calendar > Settings > calendar > "Integrate calendar"
KIOSK_CALENDAR_IDS=info@distillerylabs.org

# Neon PostgreSQL (shared with desilo-distillery — startup intelligence data)
# From the "media-brief-system" Neon project
MEDIA_BRIEF_DB_URL=postgresql://user:pass@host/neondb?sslmode=require

# Serper.dev (web search for Builder Radar news digest)
# Get this from: https://serper.dev/
SERPER_API_KEY=your_serper_api_key

# Vercel Cron Secret (auto-generated by Vercel, or set any secure random string)
CRON_SECRET=your_cron_secret
